# 애플리케이션
NODE_ENV=development
PORT=3000

# PostgreSQL 연결 URL
# 형식: postgresql://{user}:{password}@{host}:{port}/{database}?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/my_kiosk_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 인증
JWT_SECRET=
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_DAYS=7

# 좌석
# 고정석 선점 유효시간(분) - 결제 없이 방치된 고정석 선점이 풀리기까지의 시간
SEAT_HOLD_MINUTES=10

# 환불 운영 설정 (API 계약 §8, 생략하면 아래 기본값 사용)
# 시간·횟수·건수는 1 이상 정수, REFUND_RESEND_LIMIT만 0 이상 정수
# REFUND_WORK_LEASE_SECONDS > REFUND_PG_TIMEOUT_SECONDS
# REFUND_QUERY_INTERVAL_SECONDS >= REFUND_SWEEP_INTERVAL_SECONDS + REFUND_PG_TIMEOUT_SECONDS
# REFUND_QUERY_BACKOFF_MAX_SECONDS >= REFUND_QUERY_BACKOFF_SECONDS

# 공통 용어: 결과 확인 오류(QUERY_ERROR)
# PG 응답이 없거나 응답 내용으로 환불 처리 상태를 판단할 수 없는 경우
# 예: PG 미연동·통신 실패·응답 시간 초과·인증 실패·서버 오류,
#     환불 성공 응답의 실제 환불 금액 누락
# PG가 정상적으로 '환불 처리 중' 또는 '환불 실패 확정'이라고 응답한 경우는 포함하지 않음

# ── 작업 탐색·응답 대기 ──

# 환불 작업 탐색 주기(초)
# DB에서 PG에 환불을 요청하거나 처리 결과를 확인할 예정 시각이 된 작업을 찾음
REFUND_SWEEP_INTERVAL_SECONDS=5

# PG 응답을 기다리는 최대 시간(초)
# PG에 환불 요청 또는 환불 처리 결과 확인 요청을 보낸 뒤 적용
REFUND_PG_TIMEOUT_SECONDS=10

# 담당 작업자에게 부여하는 처리 시간(초)
# 동일 환불 요청의 중복 처리를 막거나 PG에 환불 요청·결과 확인 요청을 보내는 작업에 적용
REFUND_WORK_LEASE_SECONDS=30

# ── PG 환불 결과가 미확정일 때: 결과 확인·오류 대응 ──
# 아래 옵션은 PG에 환불 처리 결과를 확인하는 동작에 적용하며, 환불 요청 자체의 재전송은 별도 설정

# 환불 요청에 응답이 없을 때, PG에 처리 결과를 처음 확인 요청하기까지의 대기 시간(초)
REFUND_RESULT_WAIT_SECONDS=60

# PG가 '환불 처리 중' 등 **정상 응답**을 했지만 **결과는 미확정**일 때, PG에 다시 확인 요청하는 간격(초)
# 결과 확인 오류 시에는 아래 기본 대기 시간·상한을 적용
REFUND_QUERY_INTERVAL_SECONDS=15

# 결과 확인 **오류 후**, PG에 환불 처리 결과를 다시 확인 요청하기까지의 기본 대기 시간(초)
REFUND_QUERY_BACKOFF_SECONDS=15

# 결과 확인 **오류 후** 대기 시간의 상한(초)
# 같은 환불의 첫 오류에는 기본 대기 시간을 적용하고, 이후 연속 오류마다 2배로 늘리되 이 값을 넘지 않음
REFUND_QUERY_BACKOFF_MAX_SECONDS=300

# 같은 환불의 결과 확인 오류가 연속으로 이 횟수에 도달하면 장애 복구 확인 방식으로 전환(회)
# 해당 PG 환불 요청을 QUERY_FAILED로 기록하고 아래 절차로 자동 확인을 계속하며, 환불 실패로 확정하지 않음
REFUND_QUERY_FAILURE_THRESHOLD=5

# ── 장애 복구 확인·처리 단위 ──

# PG 장애 복구 여부를 확인하는 간격(초)
# 결과 확인 실패(QUERY_FAILED) 상태인 PG 환불 요청 중
# 가장 오래된 1건의 처리 결과를 이 간격마다 PG에 자동으로 다시 확인 요청
# 정상 응답을 받으면 REFUND_RECOVERY_BATCH_SIZE건씩 결과 확인을 진행
# 결과 확인 오류가 다시 발생하면 **1건씩 장애 복구 여부를 확인**하는 방식으로 돌아감
REFUND_RECOVERY_PROBE_SECONDS=900

# PG에 환불 처리 결과 확인을 요청할 대상을 **한 번에 처리하는 단위(건)**
# 평상시와 장애 복구 후 모두 적용
REFUND_RECOVERY_BATCH_SIZE=20

# ── 환불 요청 재전송 ──

# PG 미접수가 확실히 확인된 동일 환불 요청의 백그라운드 자동 재전송 한도(회)
# 최초 전송은 세지 않으며, 0이면 자동 재전송하지 않음
#
# 점주·운영자의 개별 확인에서 **PG 미접수가 확인되어 **다시 보내는 경우:
# - 기존 요청이 미확정이면 같은 식별자로 전송
#   자동 재전송 한도로 차단하지 않으며, 기존 자동 횟수를 늘리거나 초기화하지 않음
# - 기존 요청이 한도 소진으로 실패 종료됐다면 재시도 조건 검사 후 새 요청을 생성·전송
#   이전 실패 이력·횟수는 보존하고, 새 요청의 자동 횟수는 0부터 시작
# 이후 백그라운드 자동 재전송에는 이 한도를 적용
REFUND_RESEND_LIMIT=3

# ── 별도 환불금 지급 알림 ──

# 별도 환불금 지급 예약 후 미확인 알림까지의 대기 시간(초)
# 예약 후 실제 지급 여부가 확인되지 않은 채 이 시간이 지나면 알림을 한 번 남김
REFUND_MANUAL_CONFIRM_ALERT_SECONDS=3600

# PG 콜백 서명
PG_CALLBACK_MAX_SKEW_SECONDS=300
# 공유 서명 비밀값 (필수, 최소 32자, 기본값 없음)
PG_CALLBACK_SECRET=
