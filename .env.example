# 애플리케이션
NODE_ENV=development
PORT=3000

# PostgreSQL 연결 URL
# 형식: postgresql://{user}:{password}@{host}:{port}/{database}?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/my_kiosk_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 인증
JWT_SECRET=
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_DAYS=7

# 좌석
# 고정석 선점 유효시간(분) - 결제 없이 방치된 고정석 선점이 풀리기까지의 시간
SEAT_HOLD_MINUTES=10

# 환불 PG 요청·조회·복구 (API 계약 §8 운영 설정, 생략하면 아래 기본값 사용)
# 시간·횟수는 1 이상 정수, REFUND_RESEND_LIMIT만 0 이상 정수
# REFUND_WORK_LEASE_SECONDS > REFUND_PG_TIMEOUT_SECONDS
# REFUND_QUERY_INTERVAL_SECONDS >= REFUND_SWEEP_INTERVAL_SECONDS + REFUND_PG_TIMEOUT_SECONDS
# REFUND_QUERY_BACKOFF_MAX_SECONDS >= REFUND_QUERY_BACKOFF_SECONDS
REFUND_RESULT_WAIT_SECONDS=60
REFUND_SWEEP_INTERVAL_SECONDS=5
REFUND_QUERY_INTERVAL_SECONDS=15
REFUND_PG_TIMEOUT_SECONDS=10
REFUND_WORK_LEASE_SECONDS=30
REFUND_QUERY_BACKOFF_SECONDS=15
REFUND_QUERY_BACKOFF_MAX_SECONDS=300
REFUND_QUERY_FAILURE_THRESHOLD=5
REFUND_RECOVERY_PROBE_SECONDS=900
REFUND_RECOVERY_BATCH_SIZE=20
REFUND_RESEND_LIMIT=3
REFUND_MANUAL_CONFIRM_ALERT_SECONDS=3600

# PG 콜백 서명
PG_CALLBACK_MAX_SKEW_SECONDS=300
# 공유 서명 비밀값 (필수, 최소 32자, 기본값 없음)
PG_CALLBACK_SECRET=
